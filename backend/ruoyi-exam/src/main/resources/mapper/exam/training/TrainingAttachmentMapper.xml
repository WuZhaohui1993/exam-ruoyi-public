<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.exam.training.mapper.TrainingAttachmentMapper">

    <resultMap type="TrainingAttachment" id="TrainingAttachmentResult">
        <id     property="id"             column="id"              />
        <result property="examId"         column="exam_id"         />
        <result property="examUserId"     column="exam_user_id"    />
        <result property="answerRecordId" column="answer_record_id"/>
        <result property="userId"         column="user_id"         />
        <result property="fileName"       column="file_name"       />
        <result property="fileUrl"        column="file_url"        />
        <result property="fileType"       column="file_type"       />
        <result property="fileSize"       column="file_size"       />
        <result property="uploadSource"   column="upload_source"   />
        <result property="status"         column="status"          />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <result property="remark"         column="remark"          />
    </resultMap>

    <sql id="selectTrainingAttachmentVo">
        select id, exam_id, exam_user_id, answer_record_id, user_id, file_name, file_url,
               file_type, file_size, upload_source, status, create_by, create_time,
               update_by, update_time, remark
        from exam_training_attachment
    </sql>

    <select id="selectTrainingAttachmentList" parameterType="TrainingAttachment" resultMap="TrainingAttachmentResult">
        <include refid="selectTrainingAttachmentVo"/>
        <where>
            <if test="examId != null">AND exam_id = #{examId}</if>
            <if test="examUserId != null">AND exam_user_id = #{examUserId}</if>
            <if test="answerRecordId != null">AND answer_record_id = #{answerRecordId}</if>
            <if test="userId != null">AND user_id = #{userId}</if>
            <if test="fileType != null and fileType != ''">AND file_type = #{fileType}</if>
            <if test="uploadSource != null and uploadSource != ''">AND upload_source = #{uploadSource}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
        order by create_time desc, id desc
    </select>

    <select id="selectTrainingAttachmentById" parameterType="Long" resultMap="TrainingAttachmentResult">
        <include refid="selectTrainingAttachmentVo"/>
        where id = #{id}
    </select>

    <select id="countTrainingAttachment" parameterType="TrainingAttachment" resultType="int">
        select count(1)
        from exam_training_attachment
        <where>
            <if test="examId != null">AND exam_id = #{examId}</if>
            <if test="examUserId != null">AND exam_user_id = #{examUserId}</if>
            <if test="answerRecordId != null">AND answer_record_id = #{answerRecordId}</if>
            <if test="userId != null">AND user_id = #{userId}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
    </select>

    <insert id="insertTrainingAttachment" parameterType="TrainingAttachment" useGeneratedKeys="true" keyProperty="id">
        insert into exam_training_attachment(
            exam_id, exam_user_id, answer_record_id, user_id, file_name, file_url,
            file_type, file_size, upload_source, status, create_by, create_time, remark
        ) values (
            #{examId}, #{examUserId}, #{answerRecordId}, #{userId}, #{fileName}, #{fileUrl},
            #{fileType}, #{fileSize}, #{uploadSource}, #{status}, #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <delete id="deleteTrainingAttachmentByIds" parameterType="Long">
        delete from exam_training_attachment where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
