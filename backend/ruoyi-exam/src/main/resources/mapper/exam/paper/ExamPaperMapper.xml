<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.exam.paper.mapper.ExamPaperMapper">
    
    <resultMap type="ExamPaper" id="ExamPaperResult">
        <result property="id"               column="id"               />
        <result property="paperName"        column="paper_name"       />
        <result property="categoryId"       column="category_id"      />
        <result property="categoryName"     column="category_name"    />
        <result property="paperType"        column="paper_type"       />
        <result property="paperDescription" column="paper_description"/>
        <result property="totalScore"       column="total_score"      />
        <result property="passScore"        column="pass_score"       />
        <result property="duration"         column="duration"         />
        <result property="questionCount"    column="question_count"   />
        <result property="difficultyLevel"  column="difficulty_level" />
        <result property="status"           column="status"           />
        <result property="shuffleQuestions" column="shuffle_questions"/>
        <result property="shuffleOptions"   column="shuffle_options"  />
        <result property="questionConfig"   column="question_config"  />
        <result property="createBy"         column="create_by"        />
        <result property="createTime"       column="create_time"      />
        <result property="updateBy"         column="update_by"        />
        <result property="updateTime"       column="update_time"      />
        <result property="remark"           column="remark"           />
    </resultMap>

    <resultMap type="ExamPaperQuestion" id="ExamPaperQuestionResult">
        <result property="id"            column="id"            />
        <result property="paperId"       column="paper_id"      />
        <result property="questionId"    column="question_id"   />
        <result property="questionOrder" column="question_order"/>
        <result property="score"         column="score"         />
        <result property="createTime"    column="create_time"   />
        <association property="question" javaType="ExamQuestion">
            <result property="id"              column="q_id"              />
            <result property="questionTitle"   column="q_question_title"  />
            <result property="questionContent" column="q_question_content"/>
            <result property="questionType"    column="q_question_type"   />
            <result property="questionOptions" column="q_question_options"/>
            <result property="correctAnswer"   column="q_correct_answer"  />
            <result property="questionAnalysis" column="q_question_analysis"/>
            <result property="difficultyLevel" column="q_difficulty_level"/>
            <result property="tags"            column="q_tags"            />
        </association>
    </resultMap>

    <sql id="selectPaperVo">
        select p.id, p.paper_name, p.category_id, c.category_name, p.paper_type, p.paper_description, 
               p.total_score, p.pass_score, p.duration, p.question_count, p.difficulty_level, p.status, 
               p.shuffle_questions, p.shuffle_options, p.question_config, 
               p.create_by, p.create_time, p.update_by, p.update_time, p.remark 
        from exam_paper p
        left join exam_paper_category c on p.category_id = c.id
    </sql>

    <select id="selectPaperList" parameterType="ExamPaper" resultMap="ExamPaperResult">
        <include refid="selectPaperVo"/>
        <where>
            <if test="paperName != null and paperName != ''">
                AND p.paper_name like concat('%', #{paperName}, '%')
            </if>
            <if test="categoryId != null">
                AND p.category_id = #{categoryId}
            </if>
            <if test="paperType != null and paperType != ''">
                AND p.paper_type = #{paperType}
            </if>
            <if test="status != null and status != ''">
                AND p.status = #{status}
            </if>
            <if test="difficultyLevel != null">
                AND p.difficulty_level = #{difficultyLevel}
            </if>
        </where>
        order by p.create_time desc
    </select>

    <select id="selectPaperById" parameterType="Long" resultMap="ExamPaperResult">
        <include refid="selectPaperVo"/>
        where p.id = #{id}
    </select>

    <select id="selectPapersByCategoryId" parameterType="Long" resultMap="ExamPaperResult">
        <include refid="selectPaperVo"/>
        where p.category_id = #{categoryId} and p.status = '0'
        order by p.create_time desc
    </select>

    <select id="selectPapersByType" parameterType="String" resultMap="ExamPaperResult">
        <include refid="selectPaperVo"/>
        where p.paper_type = #{paperType} and p.status = '0'
        order by p.create_time desc
    </select>

    <select id="checkPaperNameUnique" resultMap="ExamPaperResult">
        <include refid="selectPaperVo"/>
        where p.paper_name = #{paperName} and p.category_id = #{categoryId} limit 1
    </select>

    <select id="countPapers" parameterType="ExamPaper" resultType="int">
        select count(1) from exam_paper p
        <where>
            <if test="categoryId != null">
                AND p.category_id = #{categoryId}
            </if>
            <if test="paperType != null and paperType != ''">
                AND p.paper_type = #{paperType}
            </if>
            <if test="status != null and status != ''">
                AND p.status = #{status}
            </if>
            <if test="difficultyLevel != null">
                AND p.difficulty_level = #{difficultyLevel}
            </if>
        </where>
    </select>

    <insert id="insertPaper" parameterType="ExamPaper" useGeneratedKeys="true" keyProperty="id">
        insert into exam_paper(
            <if test="paperName != null and paperName != ''">paper_name,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="paperType != null and paperType != ''">paper_type,</if>
            <if test="paperDescription != null and paperDescription != ''">paper_description,</if>
            <if test="totalScore != null">total_score,</if>
            <if test="passScore != null">pass_score,</if>
            <if test="duration != null">duration,</if>
            <if test="questionCount != null">question_count,</if>
            <if test="difficultyLevel != null">difficulty_level,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="shuffleQuestions != null and shuffleQuestions != ''">shuffle_questions,</if>
            <if test="shuffleOptions != null and shuffleOptions != ''">shuffle_options,</if>
            <if test="questionConfig != null and questionConfig != ''">question_config,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="paperName != null and paperName != ''">#{paperName},</if>
            <if test="categoryId != null">#{categoryId},</if>
            <if test="paperType != null and paperType != ''">#{paperType},</if>
            <if test="paperDescription != null and paperDescription != ''">#{paperDescription},</if>
            <if test="totalScore != null">#{totalScore},</if>
            <if test="passScore != null">#{passScore},</if>
            <if test="duration != null">#{duration},</if>
            <if test="questionCount != null">#{questionCount},</if>
            <if test="difficultyLevel != null">#{difficultyLevel},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="shuffleQuestions != null and shuffleQuestions != ''">#{shuffleQuestions},</if>
            <if test="shuffleOptions != null and shuffleOptions != ''">#{shuffleOptions},</if>
            <if test="questionConfig != null and questionConfig != ''">#{questionConfig},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updatePaper" parameterType="ExamPaper">
        update exam_paper
        <trim prefix="SET" suffixOverrides=",">
            <if test="paperName != null and paperName != ''">paper_name = #{paperName},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="paperType != null and paperType != ''">paper_type = #{paperType},</if>
            <if test="paperDescription != null">paper_description = #{paperDescription},</if>
            <if test="totalScore != null">total_score = #{totalScore},</if>
            <if test="passScore != null">pass_score = #{passScore},</if>
            <if test="duration != null">duration = #{duration},</if>
            <if test="questionCount != null">question_count = #{questionCount},</if>
            <if test="difficultyLevel != null">difficulty_level = #{difficultyLevel},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="shuffleQuestions != null">shuffle_questions = #{shuffleQuestions},</if>
            <if test="shuffleOptions != null">shuffle_options = #{shuffleOptions},</if>
            <if test="questionConfig != null">question_config = #{questionConfig},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePaperById" parameterType="Long">
        delete from exam_paper where id = #{id}
    </delete>

    <delete id="deletePaperByIds" parameterType="String">
        delete from exam_paper where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 试卷试题关联查询 -->
    <select id="selectPaperQuestions" parameterType="Long" resultMap="ExamPaperQuestionResult">
        select pq.id, pq.paper_id, pq.question_id, pq.question_order, pq.score, pq.create_time,
               q.id as q_id, q.question_title as q_question_title, q.question_content as q_question_content,
               q.question_type as q_question_type, q.question_options as q_question_options,
               q.correct_answer as q_correct_answer, q.question_analysis as q_question_analysis,
               q.difficulty_level as q_difficulty_level, q.tags as q_tags
        from exam_paper_question pq
        left join exam_question q on pq.question_id = q.id
        where pq.paper_id = #{paperId}
        order by pq.question_order
    </select>

    <insert id="insertPaperQuestion" parameterType="ExamPaperQuestion">
        insert into exam_paper_question(paper_id, question_id, question_order, score, create_time)
        values(#{paperId}, #{questionId}, #{questionOrder}, #{score}, sysdate())
    </insert>

    <insert id="batchInsertPaperQuestion" parameterType="java.util.List">
        insert into exam_paper_question(paper_id, question_id, question_order, score, create_time) values
        <foreach collection="list" item="item" index="index" separator=",">
            (#{item.paperId}, #{item.questionId}, #{item.questionOrder}, #{item.score}, sysdate())
        </foreach>
    </insert>

    <delete id="deletePaperQuestionByPaperId" parameterType="Long">
        delete from exam_paper_question where paper_id = #{paperId}
    </delete>

    <!-- 随机获取试题 -->
    <select id="selectRandomQuestions" resultType="ExamQuestion">
        select id, category_id, question_type, question_title, question_content, question_options,
               correct_answer, question_analysis, difficulty_level, tags, status
        from exam_question
        <where>
            status = '0'
            <if test="categoryId != null">
                AND category_id = #{categoryId}
            </if>
            <if test="questionType != null and questionType != ''">
                AND question_type = #{questionType}
            </if>
            <if test="difficultyLevel != null">
                AND difficulty_level = #{difficultyLevel}
            </if>
        </where>
        order by rand()
        <if test="count != null and count > 0">
            limit #{count}
        </if>
    </select>

    <!-- 统计引用该试卷的考试数量 -->
    <select id="countExaminationsByPaperId" parameterType="Long" resultType="int">
        select count(*) from exam_examination where paper_id = #{paperId}
    </select>

</mapper> 